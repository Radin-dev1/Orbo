# ─────────────────────────────────────────────────────────────
# Orbo environment
# Copy to .env.local and fill in. .env.local is git-ignored.
# ─────────────────────────────────────────────────────────────

# --- Supabase (from Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Secret. Server-only. Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- Direct Postgres connection (used ONLY by `npm run migrate`) ---
# Project Settings → Database → Connection string → "Session pooler" or "Direct".
# Contains your database password.
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- WebRTC ---
# JSON array of RTCIceServer entries. Public STUN is enough for devices on the
# same network. Add a TURN server for calls that must cross NATs / firewalls
# (e.g. a free relay from metered.ca, or self-hosted coturn).
NEXT_PUBLIC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"stun:global.stun.twilio.com:3478"}]

# Group calls use a full-mesh WebRTC topology (every participant connects to
# every other). Keep this modest; ~6 is a sane ceiling before an SFU is needed.
NEXT_PUBLIC_MAX_CALL_PARTICIPANTS=6
